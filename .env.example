# VoxPulse AI Configuration
PORT=3001
VITE_API_URL=http://localhost:3001

# Google Gemini API Key (Optional: replace with your key for live Gemini AI responses)
GEMINI_API_KEY=

# Telephony Credentials (Optional: add your Twilio / Telnyx API details for live PSTN calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# Keycloak SSO Settings
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=voxpulse-realm
KEYCLOAK_CLIENT_ID=voxpulse-app

# Environment
NODE_ENV=development
